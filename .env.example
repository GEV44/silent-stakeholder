# GitHub: recommended for full roadmap pulls (public-repo read access only).
GITHUB_TOKEN=

# Choose one Gemini authentication path.
# Path A: Gemini Developer API.
GOOGLE_API_KEY=

# Path B: Vertex AI Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Pin the experimental instrument. 3.5 supports the sampling controls used by
# the stability study; 3.6 currently ignores custom sampling parameters.
FIRECODE_GEMINI_MODEL=gemini-3.5-flash
FIRECODE_GEMINI_API_VERSION=v1

# Optional runtime controls.
FIRECODE_OFFLINE=false
FIRECODE_RANDOM_SEED=42

# --- LLM layer (src/llm.py) -------------------------------------------------
# Force a backend instead of auto-detecting: vertex | developer_api | offline.
FIRECODE_LLM_BACKEND=
# Deterministic extraction uses 0.0; self-consistency sampling uses ~0.7.
FIRECODE_LLM_TEMPERATURE=0.0
FIRECODE_SC_SAMPLES=5
FIRECODE_SC_TEMPERATURE=0.7
FIRECODE_MAX_OUTPUT_TOKENS=8192
# Set these below the quota actually allocated to the selected serving surface.
FIRECODE_LLM_CONCURRENCY=4
FIRECODE_LLM_RPM=60
FIRECODE_LLM_RETRIES=5
FIRECODE_LLM_TIMEOUT=120
# Responses are disk-cached under data/llm_cache/ so re-runs are free and the
# demo can replay with the network unplugged. Set true to bypass without deleting.
FIRECODE_LLM_NO_CACHE=false
# Upper bound on IDs injected as a schema enum for evidence grounding.
FIRECODE_MAX_ENUM_IDS=150

# --- Embeddings (local by design: no network dependency during the demo) ----
FIRECODE_EMBED_BACKEND=auto
FIRECODE_EMBED_MODEL=BAAI/bge-small-en-v1.5
